#!/usr/bin/env bash
# 按龄清扫构建产物（docs/standards/08 §7）：默认清 30 天未用产物；禁止例行全清。
# --full 仅在配置了 sccache（RUSTC_WRAPPER）时允许（重编代价可控）。
set -euo pipefail
cd "$(dirname "$0")/.."

if [ "${1:-}" = "--full" ]; then
    if [ "${RUSTC_WRAPPER:-}" != "sccache" ]; then
        echo "拒绝全清：未检测到 RUSTC_WRAPPER=sccache（标准 08 §7：仅 sccache 在位时允许 cargo clean）。"
        echo "请用按龄清扫：scripts/clean-stale"
        exit 1
    fi
    cargo clean
    echo "已全清 target/（sccache 缓存保留，重编近乎免费）。"
    exit 0
fi

if command -v cargo-sweep >/dev/null 2>&1; then
    cargo sweep -t 30
    echo "已清扫 30 天未用产物（按龄不全清）。"
else
    echo "未安装 cargo-sweep。安装：cargo install cargo-sweep"
    echo "手工等价命令：cargo sweep -t 30"
    exit 1
fi
