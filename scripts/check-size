#!/usr/bin/env bash
# 体量核对（docs/standards/08 §4/§7）
# 1) 单源文件 >500 行 → fail（行内含 SIZE-EXEMPT(<理由>) 注释可豁免，须在进度报告登记）
# 2) #[allow(dead_code)] 无归属注释（同行或上一行含 TODO( 或 dead-code:）→ fail
# 3) target/ 对照 15GB 软限（warn）/ 25GB 硬限（fail）；incremental >4GB 提醒
set -uo pipefail
cd "$(dirname "$0")/.."
fail=0

while IFS= read -r f; do
    lines=$(wc -l < "$f")
    if [ "$lines" -gt 500 ]; then
        if grep -q "SIZE-EXEMPT(" "$f"; then
            echo "WARN  $f: $lines 行（已豁免：$(grep -o 'SIZE-EXEMPT([^)]*)' "$f" | head -1)）"
        else
            echo "FAIL  $f: $lines 行 > 500（标准 08 §4；如确需豁免加 SIZE-EXEMPT(理由) 注释并登记进度报告）"
            fail=1
        fi
    fi
    if grep -n "allow(dead_code)" "$f" | while IFS=: read -r ln _; do
            prev=$((ln - 1)); [ "$prev" -ge 1 ] && ctx=$(sed -n "${prev}p;${ln}p" "$f")
            [ "$prev" -lt 1 ] && ctx=$(sed -n "${ln}p" "$f")
            echo "$ctx" | grep -qE "TODO\(|dead-code:" || echo "ORPHAN $f:$ln"
        done | grep -q ORPHAN; then
        echo "FAIL  $f: 存在无归属的 #[allow(dead_code)]（标准 08 §4 零容忍）"
        fail=1
    fi
done < <(find crates apps -name "*.rs" -type f 2>/dev/null)

if [ -d target ]; then
    read -r total incremental deps < <(bash scripts/target-size)
    gb() { awk -v b="$1" 'BEGIN { printf "%.1f", b / 1073741824 }'; }
    soft=$((15 * 1024 * 1024 * 1024))
    hard=$((25 * 1024 * 1024 * 1024))
    if [ "$total" -ge "$hard" ]; then
        echo "FAIL  target/ $(gb "$total")GiB ≥ 25GiB 硬上限（标准 08 §7）——运行 scripts/clean-build"
        fail=1
    elif [ "$total" -ge "$soft" ]; then
        echo "WARN  target/ $(gb "$total")GiB ≥ 15GiB 软上限（标准 08 §7）——收尾前运行 scripts/clean-build"
    else
        echo "OK    target/ $(gb "$total")GiB（软上限 15GiB）"
    fi
    echo "      分类：incremental $(gb "$incremental")GiB / deps $(gb "$deps")GiB"
    if [ "$incremental" -ge $((4 * 1024 * 1024 * 1024)) ] && [ "$total" -lt "$hard" ]; then
        echo "WARN  incremental $(gb "$incremental")GiB ≥ 4GiB（标准 08 §7）——scripts/clean-build 会先删它"
    fi
fi

if [ "$fail" -ne 0 ]; then
    echo "check-size: FAIL"; exit 1
fi
echo "check-size: OK"
